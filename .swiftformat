--min-version 0.64.6
--allman false
--allow-partial-wrapping false
--anonymous-for-each convert
--asset-literals visual-width
--binary-grouping 4,8
--blank-line-after-switch-case multiline-only
--call-site-paren same-line
--closure-void remove
--complex-attributes preserve
--computed-var-attributes preserve
--conditional-assignment after-property
--date-format system
--decimal-grouping 3,6
--doc-comments before-declarations
--else-position next-line
--empty-braces no-space
--enum-namespaces always
--equatable-macro none
--exponent-case lowercase
--exponent-grouping disabled
--extension-acl on-declarations
--file-macro "#file"
--fraction-grouping disabled
--func-attributes preserve
--guard-else auto
--header ignore
--hex-grouping 4,8
--hex-literal-case uppercase
--ifdef no-indent
--import-grouping alpha
--indent 4
--indent-blank-lines false
--indent-case false
--indent-strings false
--init-coder-nil false
--line-after-marks true
--line-between-guards false
--linebreaks lf
--list-wrap-threshold none
--markdown-files ignore
--max-width none
--nil-init remove
--octal-grouping 4,8
--operator-func spaced
--pattern-let hoist
--prefer-synthesized-init-for-internal-structs never
--property-types infer-locals-only
--ranges spaced
--redundant-async tests-only
--redundant-optional-binding same-name-only
--redundant-throws tests-only
--self init-only
--semicolons inline-only
--short-optionals except-properties
--single-line-for-each ignore
--smart-tabs enabled
--some-any true
--stored-var-attributes preserve
--suite-name-format preserve
--tab-width unspecified
--test-case-name-format standard-identifiers
--timezone system
--trailing-commas always
--trim-whitespace always
--type-attributes prev-line
--type-blank-lines preserve
--type-delimiter space-after
--void-type Void
--wrap-arguments before-first
--wrap-collections before-first
--wrap-conditions preserve
--wrap-effects never
--wrap-enum-cases with-values
--wrap-parameters before-first
--wrap-return-type never
--wrap-string-interpolation false
--wrap-ternary before-operators
--wrap-type-aliases before-first
--xcode-indentation enabled
--yoda-swap always
--disable trailingClosures,unusedArguments
--enable blankLineAfterSwitchCase,blankLinesAfterGuardStatements,blockComments,isEmpty,preferContains,preferCountWhere,preferFirstWhere,preferFlatMap,preferMinOverSorted,preferSwiftStringAPI,preferSwiftTesting,singlePropertyPerLine,sortSwitchCases,unusedPrivateDeclarations,wrapEnumCases,wrapMultilineConditionalAssignment,wrapMultilineFunctionChains,commonTypos,forWhere,emptyExtensions,noExplicitOwnership

# Build products, dependency checkouts and generated data. SwiftFormat
# rewrites files in place, so these must never be scanned.
--exclude .build,.swiftpm
